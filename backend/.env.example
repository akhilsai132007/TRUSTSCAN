# TRUSTSCAN Backend Environment Configuration

# Core
ALLOWED_ORIGINS=["http://localhost:5173", "https://your-frontend-domain.vercel.app"]

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trustscan

# AI Risk Thresholds (Overrides defaults)
THRESHOLD_FACE_MATCH=0.75
THRESHOLD_TAMPER=0.40
THRESHOLD_TAMPER_EXTREME=0.80
THRESHOLD_METADATA=0.50
